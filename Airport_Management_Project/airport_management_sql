DROP DATABASE IF EXISTS airport_management;
CREATE DATABASE airport_management;
USE airport_management;

-- 1. AIRPLANE MODEL
CREATE TABLE Airplane_Model (
                                model_no VARCHAR(20) PRIMARY KEY,
                                capacity INT NOT NULL,
                                weight DECIMAL(10,2)
);

-- 2. AIRPLANE
CREATE TABLE Airplane (
                          plane_no VARCHAR(20) PRIMARY KEY,
                          model_no VARCHAR(20) NOT NULL,
                          FOREIGN KEY (model_no) REFERENCES Airplane_Model(model_no)
);

-- 3. HANGAR
CREATE TABLE Hangar (
                        hangar_no INT PRIMARY KEY,
                        location VARCHAR(100) NOT NULL,
                        capacity INT NOT NULL
);

-- 4. AIRPLANE LOCATION HISTORY
CREATE TABLE Airplane_Location (
                                   location_id INT AUTO_INCREMENT PRIMARY KEY,
                                   plane_no VARCHAR(20) NOT NULL,
                                   hangar_no INT NOT NULL,
                                   in_date DATE NOT NULL,
                                   out_date DATE,
                                   FOREIGN KEY (plane_no) REFERENCES Airplane(plane_no),
                                   FOREIGN KEY (hangar_no) REFERENCES Hangar(hangar_no)
);

-- 5. EMPLOYEE
CREATE TABLE Employee (
                          ssn VARCHAR(20) PRIMARY KEY,
                          name VARCHAR(100) NOT NULL,
                          phone VARCHAR(20),
                          address VARCHAR(150),
                          salary DECIMAL(10,2),
                          union_member_no VARCHAR(30) UNIQUE NOT NULL
);

-- 6. TECHNICIAN
CREATE TABLE Technician (
                            ssn VARCHAR(20) PRIMARY KEY,
                            FOREIGN KEY (ssn) REFERENCES Employee(ssn)
);

-- 7. TRAFFIC CONTROLLER
CREATE TABLE Traffic_Controller (
                                    ssn VARCHAR(20) PRIMARY KEY,
                                    most_recent_exam_date DATE NOT NULL,
                                    FOREIGN KEY (ssn) REFERENCES Employee(ssn)
);

-- 8. AIRPORT WORKER
CREATE TABLE Airport_Worker (
                                ssn VARCHAR(20) PRIMARY KEY,
                                job_title VARCHAR(50),
                                FOREIGN KEY (ssn) REFERENCES Employee(ssn)
);

-- 9. TECHNICIAN EXPERTISE
CREATE TABLE Technician_Expertise (
                                      ssn VARCHAR(20),
                                      model_no VARCHAR(20),
                                      PRIMARY KEY (ssn, model_no),
                                      FOREIGN KEY (ssn) REFERENCES Technician(ssn),
                                      FOREIGN KEY (model_no) REFERENCES Airplane_Model(model_no)
);

-- 10. TEST
CREATE TABLE Test (
                      test_no INT PRIMARY KEY,
                      test_name VARCHAR(100) NOT NULL,
                      max_score INT NOT NULL
);

-- 11. TEST EVENT
CREATE TABLE Test_Event (
                            event_id INT AUTO_INCREMENT PRIMARY KEY,
                            plane_no VARCHAR(20) NOT NULL,
                            ssn VARCHAR(20) NOT NULL,
                            test_no INT NOT NULL,
                            test_date DATE NOT NULL,
                            hours_spent DECIMAL(5,2) NOT NULL,
                            score INT NOT NULL,
                            FOREIGN KEY (plane_no) REFERENCES Airplane(plane_no),
                            FOREIGN KEY (ssn) REFERENCES Technician(ssn),
                            FOREIGN KEY (test_no) REFERENCES Test(test_no)
);

