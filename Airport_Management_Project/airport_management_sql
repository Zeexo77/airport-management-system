-- 15 REQUIRED QUERIES

-- 1. Show all airplanes with their models
SELECT a.plane_no, a.model_no, m.capacity
FROM Airplane a
         JOIN Airplane_Model m ON a.model_no = m.model_no;

-- 2. Show current location of airplanes
SELECT a.plane_no, h.hangar_no, h.location
FROM Airplane_Location al
         JOIN Airplane a ON al.plane_no = a.plane_no
         JOIN Hangar h ON al.hangar_no = h.hangar_no
WHERE al.out_date IS NULL;

-- 3. Show all technicians
SELECT e.ssn, e.name, e.phone
FROM Employee e
         JOIN Technician t ON e.ssn = t.ssn;

-- 4. Show technician expertise
SELECT e.name, te.model_no
FROM Technician_Expertise te
         JOIN Employee e ON te.ssn = e.ssn;

-- 5. Show traffic controllers and exam dates
SELECT e.name, tc.most_recent_exam_date
FROM Traffic_Controller tc
         JOIN Employee e ON tc.ssn = e.ssn;

-- 6. Show all test events
SELECT te.event_id, te.plane_no, e.name AS technician, t.test_name, te.test_date, te.score
FROM Test_Event te
         JOIN Employee e ON te.ssn = e.ssn
         JOIN Test t ON te.test_no = t.test_no;

-- 7. Average score for each airplane
SELECT plane_no, AVG(score) AS average_score
FROM Test_Event
GROUP BY plane_no;

-- 8. Number of tests done by each technician
SELECT e.name, COUNT(*) AS total_tests
FROM Test_Event te
         JOIN Employee e ON te.ssn = e.ssn
GROUP BY e.name;

-- 9. Airplanes with score greater than 90
SELECT plane_no, score
FROM Test_Event
WHERE score > 90;

-- 10. Total hours spent by each technician
SELECT e.name, SUM(te.hours_spent) AS total_hours
FROM Test_Event te
         JOIN Employee e ON te.ssn = e.ssn
GROUP BY e.name;

-- 11. Highest test score
SELECT MAX(score) AS highest_score
FROM Test_Event;

-- 12. Lowest test score
SELECT MIN(score) AS lowest_score
FROM Test_Event;

-- 13. Tests performed after 2026-04-10
SELECT *
FROM Test_Event
WHERE test_date > '2026-04-10';

-- 14. Count airplanes in each hangar currently
SELECT h.hangar_no, h.location, COUNT(al.plane_no) AS total_airplanes
FROM Hangar h
         LEFT JOIN Airplane_Location al
                   ON h.hangar_no = al.hangar_no AND al.out_date IS NULL
GROUP BY h.hangar_no, h.location;

-- 15. Find technicians expert in B737
SELECT e.name
FROM Technician_Expertise te
         JOIN Employee e ON te.ssn = e.ssn
WHERE te.model_no = 'B737';
